{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "web",
  "functions": {
    "api/verify.py": {
      "includeFiles": "{indexer/**,web/**}",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/verify",
      "has": [
        {
          "type": "query",
          "key": "mint",
          "value": "(?<mint>[1-9A-HJ-NP-Za-km-z]+)"
        }
      ],
      "destination": "/api/verify?mint=:mint"
    },
    {
      "source": "/coins",
      "destination": "/coins-1.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/coin/:mint([1-9A-HJ-NP-Za-km-z]+).json",
      "destination": "/:mint.json"
    },
    {
      "source": "/coin/:mint([1-9A-HJ-NP-Za-km-z]+)",
      "destination": "/api/verify?mint=:mint"
    },
    {
      "source": "/verify/:mint([1-9A-HJ-NP-Za-km-z]+)",
      "destination": "/api/verify?mint=:mint"
    }
  ]
}
